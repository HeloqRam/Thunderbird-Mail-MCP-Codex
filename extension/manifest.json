{
  "manifest_version": 2,
  "name": "Thunderbird MCP Bridge",
  "description": "Connects Thunderbird to the local ChatGPT desktop mail tools.",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-mcp-bridge@local.codex",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["accountsRead", "messagesRead", "messagesUpdate", "compose", "http://127.0.0.1/*"],
  "background": { "scripts": ["connection.js", "background.js"] }
}
